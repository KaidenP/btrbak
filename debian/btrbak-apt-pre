#!/bin/sh
# btrbak-apt-pre — snapshot the `apt` group before an apt/dpkg transaction.
#
# apt may invoke dpkg several times in a single transaction; the marker file
# keeps that from producing one snapshot per dpkg invocation.

set -eu

MARKER=/var/tmp/btrbak-apt-pre.stamp
# A single apt transaction (e.g. a large dist-upgrade) can run dpkg for far
# longer than the original 600 s window, which would snapshot again
# mid-transaction. One hour covers realistic transactions; the trade-off is
# that two *separate* apt runs started within the window share one snapshot.
TTL_SECONDS=3600

now=$(date +%s)
if [ -f "$MARKER" ]; then
    mtime=$(stat -c %Y "$MARKER" 2>/dev/null || echo 0)
    if [ $((now - mtime)) -lt "$TTL_SECONDS" ]; then
        exit 0
    fi
fi

if ! touch "$MARKER" 2>/dev/null; then
    # The caller invokes us via `|| true`, so without this warning a failed
    # marker write (e.g. a read-only /var/tmp) would silently skip the
    # snapshot with no way for the admin to notice.
    echo "btrbak-apt-pre: cannot write marker $MARKER; skipping snapshot" >&2
    exit 1
fi
exec /usr/bin/btrbak run --group apt --force
