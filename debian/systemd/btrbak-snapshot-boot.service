[Unit]
Description=Create a btrbak snapshot on boot
Documentation=man:btrbak(1)
# Skip cleanly until at least one profile exists.
ConditionDirectoryNotEmpty=/etc/btrbak/profiles.d
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Full-snapshot the members of the `boot` group in /etc/btrbak/groups.yaml.
# The group is empty by default, so this is a no-op until configured.
ExecStart=/usr/bin/btrbak run --group boot --force --full
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
# AF_UNIX for local sockets, AF_INET/AF_INET6 for the gdrive/local remote
# uploads this service performs.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
