[Unit]
Description=btrbak snapshot and offsite backup run
Documentation=man:btrbak(1)
After=local-fs.target network-online.target
Wants=network-online.target
# Skip cleanly until the admin drops at least one profile into
# /etc/btrbak/profiles.d. This lets the timer be enabled by default on a
# freshly installed system without producing failed units.
ConditionDirectoryNotEmpty=/etc/btrbak/profiles.d

[Service]
Type=oneshot
ExecStart=/usr/bin/btrbak run
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
