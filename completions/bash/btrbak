# bash completion for btrbak(1)
#
# Installed as /usr/share/bash-completion/completions/btrbak so the
# bash-completion package loads it automatically.

_btrbak_command() {
    local w
    for w in "${words[@]:1}"; do
        [[ $w == -* ]] && continue
        case $w in
            config|run|verify|list|restore|forget) printf '%s\n' "$w"; return ;;
        esac
    done
}

# Number of positional arguments already present before the word being
# completed.  Flags are skipped, so `btrbak run --force <TAB>` still sees
# zero positionals.
_btrbak_pos_count() {
    local cmd=$1 w i count=0
    for ((i = 1; i < cword; i++)); do
        w=${words[i]}
        [[ $w == -* ]] && continue
        [[ $w == "$cmd" ]] && continue
        ((count++))
    done
    printf '%s\n' "$count"
}

# Print the nth (1-indexed) positional argument already present before the
# word being completed.  Options may appear anywhere, so this is more reliable
# than looking at the word immediately before the cursor.
_btrbak_pos_arg() {
    local cmd=$1 want=$2 w i count=0
    for ((i = 1; i < cword; i++)); do
        w=${words[i]}
        [[ $w == -* ]] && continue
        [[ $w == "$cmd" ]] && continue
        ((count++))
        if (( count == want )); then
            printf '%s\n' "$w"
            return
        fi
    done
}

_btrbak_subvols() {
    local f name
    local -a names
    for f in /etc/btrbak/profiles.d/*.yaml /etc/btrbak/profiles.d/*.yml; do
        [[ -f $f ]] || continue
        name=${f##*/}
        case $name in
            *.yaml) names+=("${name%.yaml}") ;;
            *.yml) names+=("${name%.yml}") ;;
        esac
    done
    # De-duplicate; .yaml is the canonical form and already sorts first.
    printf '%s\n' "${names[@]}" | sort -u
}

# Print one value per line from a profile file.  $1 is the SUBVOL, $2 is one
# of: profiles, dest.  Uses PyYAML (a btrbak dependency); silently returns
# nothing when it is unavailable.
_btrbak_config_value() {
    local subvol=$1 mode=$2
    /usr/bin/python3 - "$subvol" "$mode" 2>/dev/null <<'PY'
import os
import sys

try:
    import yaml
except Exception:
    sys.exit(0)

subvol, mode = sys.argv[1], sys.argv[2]
base = "/etc/btrbak/profiles.d"
path = None
for ext in (".yaml", ".yml"):
    candidate = os.path.join(base, subvol + ext)
    if os.path.isfile(candidate):
        path = candidate
        break
if path is None:
    sys.exit(0)

try:
    with open(path, encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
except Exception:
    sys.exit(0)

if mode == "profiles":
    profiles = data.get("profiles") or {}
    for name in sorted(profiles):
        print(name)
elif mode == "dest":
    dest = data.get("dest")
    if dest:
        print(os.path.expanduser(str(dest)))
PY
}

_btrbak_profiles() {
    _btrbak_config_value "$1" profiles
}

_btrbak_groups() {
    /usr/bin/python3 - 2>/dev/null <<'PY'
import os

try:
    import yaml
except Exception:
    raise SystemExit(0)

path = "/etc/btrbak/groups.yaml"
if not os.path.isfile(path):
    raise SystemExit(0)

try:
    with open(path, encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
except Exception:
    raise SystemExit(0)

if isinstance(data, dict):
    for name in sorted(data):
        print(name)
PY
}

_btrbak_snapshot_ids() {
    local subvol=$1 profile=$2 dest
    dest=$(_btrbak_config_value "$subvol" dest) || return
    [[ -n $dest && -d $dest/$profile ]] || return
    (cd "$dest/$profile" 2>/dev/null && compgen -d -- "$cur")
}

_btrbak() {
    local cur prev words cword
    _init_completion -n = || return

    local cmd
    cmd=$(_btrbak_command)

    if [[ -z $cmd ]]; then
        COMPREPLY=($(compgen -W 'config run verify list restore forget -v --verbose -h --help' -- "$cur"))
        return
    fi

    case $cmd in
        config)
            COMPREPLY=($(compgen -W 'check -v --verbose -h --help' -- "$cur"))
            return
            ;;
    esac

    local pos subvol profile
    pos=$(_btrbak_pos_count "$cmd")

    case $cmd in
        run)
            if [[ $prev == -g || $prev == --group ]]; then
                COMPREPLY=($(compgen -W "$(_btrbak_groups)" -- "$cur"))
                return
            fi
            local has_group= i
            for ((i = 1; i < cword; i++)); do
                if [[ ${words[i]} == -g || ${words[i]} == --group ]]; then
                    has_group=1
                    break
                fi
            done
            if [[ -n $has_group || $cur == -* ]]; then
                COMPREPLY=($(compgen -W '-g --group --force --force-config --full -n --dry-run -v --verbose -h --help' -- "$cur"))
            else
                case $pos in
                    0) COMPREPLY=($(compgen -W "$(_btrbak_subvols)" -- "$cur")) ;;
                    1)
                        subvol=$(_btrbak_pos_arg "$cmd" 1)
                        COMPREPLY=($(compgen -W "$(_btrbak_profiles "$subvol")" -- "$cur"))
                        ;;
                esac
            fi
            ;;
        verify|list)
            if [[ $cur == -* ]]; then
                COMPREPLY=($(compgen -W '-v --verbose -h --help' -- "$cur"))
            else
                case $pos in
                    0) COMPREPLY=($(compgen -W "$(_btrbak_subvols)" -- "$cur")) ;;
                    1)
                        subvol=$(_btrbak_pos_arg "$cmd" 1)
                        COMPREPLY=($(compgen -W "$(_btrbak_profiles "$subvol")" -- "$cur"))
                        ;;
                esac
            fi
            ;;
        restore)
            case $pos in
                0) COMPREPLY=($(compgen -W "$(_btrbak_subvols)" -- "$cur")) ;;
                1)
                    subvol=$(_btrbak_pos_arg "$cmd" 1)
                    COMPREPLY=($(compgen -W "$(_btrbak_profiles "$subvol")" -- "$cur"))
                    ;;
                2)
                    subvol=$(_btrbak_pos_arg "$cmd" 1)
                    profile=$(_btrbak_pos_arg "$cmd" 2)
                    COMPREPLY=($(_btrbak_snapshot_ids "$subvol" "$profile"))
                    ;;
                3) COMPREPLY=($(compgen -f -- "$cur")) ;;
            esac
            ;;
        forget)
            case $pos in
                0) COMPREPLY=($(compgen -W "$(_btrbak_subvols)" -- "$cur")) ;;
                1)
                    subvol=$(_btrbak_pos_arg "$cmd" 1)
                    COMPREPLY=($(compgen -W "$(_btrbak_profiles "$subvol")" -- "$cur"))
                    ;;
                2)
                    subvol=$(_btrbak_pos_arg "$cmd" 1)
                    profile=$(_btrbak_pos_arg "$cmd" 2)
                    COMPREPLY=($(_btrbak_snapshot_ids "$subvol" "$profile"))
                    ;;
            esac
            ;;
    esac
}

complete -F _btrbak -o bashdefault -o default btrbak
